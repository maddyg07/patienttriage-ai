  "stated_concerns": {
    "heart attack":     {"label": "believes they are having a heart attack",
                         "aliases": ["heart attack", "cardiac arrest", "my heart is failing",
                                     "heart is giving out", "mi"]},
    "stroke":           {"label": "believes they are having a stroke",
                         "aliases": ["stroke", "brain attack", "having a stroke"]},
    "anaphylaxis":      {"label": "believes they are having a severe allergic reaction",
                         "aliases": ["allergic reaction", "anaphylaxis", "anaphylactic",
                                     "throat is closing", "throat closing up"]},
    "overdose":         {"label": "reports an overdose or poisoning",
                         "aliases": ["overdose", "took too many", "poisoned", "swallowed"]},
    "cannot breathe":   {"label": "states they cannot breathe",
                         "aliases": ["i cant breathe", "i can not breathe", "i cannot breathe"]},
    "dying":            {"label": "states a sense of impending doom",
                         "aliases": ["i think im dying", "i am dying", "im going to die",
                                     "feel like im dying", "something is very wrong"]}
  },
  "_stated_concerns_note": "A concern is what the patient BELIEVES is happening. It is recorded as a concern and weighted as one. It never becomes a finding: saying 'heart attack' does not add a chest pain the patient did not describe, and it never becomes a diagnosis. A sense of impending doom is included because patients are sometimes right about it and dismissing it is a known way to miss people.",

  "baseline_hints": {
    "accident":        ["accident", "car crash", "road accident", "collision", "crash"],
    "injury":          ["injury", "injured", "got hurt", "trauma"],
    "burn":            ["burn", "burnt", "burned", "acid", "scalded", "chemical"],
    "surgery":         ["surgery", "operation", "operated", "post op", "post-op"],
    "congenital":      ["born with", "since birth", "birth defect", "congenital", "always had"],
    "previous stroke": ["previous stroke", "had a stroke before", "old stroke", "stroke in 20"],
    "palsy":           ["palsy", "bells palsy", "paralysis", "paralysed"],
    "long standing":   ["always been", "always looked", "since childhood", "for years",
                        "all my life", "scar", "scarring", "deformed", "deformity"]
  },
  "_baseline_hints_note": "Phrases in the patient's own words that may explain a facial difference as pre-existing rather than acute. They do not set the baseline answer and they do not touch the score. They put a prompt on the baseline question, because the operator in our first live test clicked 'new' while the patient was in the middle of saying they had been in an accident.",

  "negation_markers": [
    "no ", "not ", "without ", "denies ", "deny ", "dont have", "don t have",
