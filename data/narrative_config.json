                       "running a temperature"],
    "rigors":         ["shivering", "shakes", "chills", "rigors", "shaking with cold"],
    "sweating":       ["sweating", "sweaty", "clammy", "drenched in sweat", "cold sweat"],
    "seizure":        ["seizure", "fit", "convulsion", "convulsing", "blacked out shaking"],
