{
  "_disclaimer": "SIMULATED DEMONSTRATION CONFIGURATION. A vocabulary for a prototype, not a clinical NLP resource. It has not been validated against real patient speech and will miss things.",
  "_why_this_file_replaced_a_synonym_list": "The first version matched fixed phrases. A patient said 'my heart is paining a lot' and the console recognised nothing, because that phrase was not on the list and no list is ever long enough. People do not describe symptoms in clinical vocabulary. Matching now works on SITE plus SENSATION -- a body part near a word for hurting -- so 'my heart is paining', 'chest hurts', 'pain in my chest' and 'tightness across my chest' all reach the same term without any of them being written down in advance.",

  "sites": {
    "chest pain":     ["chest", "heart", "sternum", "ribcage", "rib cage", "left arm", "jaw and chest"],
    "abdominal pain": ["stomach", "tummy", "belly", "abdomen", "abdominal", "gut", "guts"],
    "headache":       ["head", "temple", "temples", "skull", "forehead"],
    "sore throat":    ["throat"],
    "wrist pain":     [],
    "back pain":      ["back", "spine", "lower back"]
  },

  "sensations": [
    "pain", "paining", "pains", "painful", "hurt", "hurts", "hurting",
    "ache", "aches", "aching", "achy", "sore", "soreness",
    "tight", "tightness", "pressure", "squeezing", "crushing", "heavy",
    "burning", "burns", "stabbing", "cramping", "cramp", "discomfort",
    "killing me", "on fire", "throbbing", "pounding"
  ],
  "site_sensation_window": 6,

  "direct_phrases": {
